# Copy to .env and fill in what you have. Everything is optional — missing
# services run as realistic mocks so the demo works with zero keys.

PORT=4000

# Set to 1 in production to block checkout outside 11:00-22:00. Left off for the
# demo so ordering works at any hour (the manual pause toggle always works).
# ENFORCE_HOURS=1

# PostgreSQL (Render). Leave unset to use local SQLite at server/data/smashbros.db
# DATABASE_URL=postgres://user:pass@host:5432/smashbros

# AI chat / marketing copy. Set one (or both) — admin Settings picks the provider.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Twilio SMS (order updates + OTP). Without these, SMS is simulated and OTP code
# is 0000 (also shown in the server log).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...

# Razorpay (payments). Without these, a simulated checkout sheet is used.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
